# ==========================================
# Second Brain AI - Environment Configuration Example
# ==========================================

# Application Settings
APP_NAME=Second Brain AI
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; PostgreSQL compatible)
DATABASE_URL=sqlite:///./second_brain.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost:5432/second_brain

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI Service Configuration
# Optional: The application includes offline heuristic & extractive summarizer fallbacks if no key is provided
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL (Vite frontend)
VITE_API_URL=http://localhost:8000/api
